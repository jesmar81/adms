# Copy to .env and fill secrets. NEVER commit .env or *.pem.
DATABASE_URL=postgresql+asyncpg://zkteco:zkteco@postgres:5432/zkteco_adms
REDIS_URL=redis://redis:6379/0
ENVIRONMENT=development
DEBUG=false

# ADMS protocol
ZKTECO_MAX_BODY_SIZE=10485760
ZKTECO_ONLINE_THRESHOLD=120
ZKTECO_STALE_AFTER=86400
ZKTECO_MAX_DEVICES=1000
ZKTECO_MAX_COMMANDS_PER_DEVICE=100
ZKTECO_ENABLE_INSPECT=false
ZKTECO_DEFAULT_TIMEZONE=UTC
ZKTECO_PERSIST_DEVICE_PASSWORD=false

# JWT RS256 (use *_FILE in production; raw PEM only via secret manager)
JWT_PRIVATE_KEY_FILE=.jwt_private.pem
JWT_PUBLIC_KEY_FILE=.jwt_public.pem
JWT_ISSUER=zkteco-adms
JWT_AUDIENCE=zkteco-adms-api
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Rate limiting (Redis-enforced; auth fails closed without Redis)
RATELIMIT_LOGIN_MAX_ATTEMPTS=10
RATELIMIT_LOGIN_WINDOW_S=60
RATELIMIT_LOCKOUT_THRESHOLD=20
RATELIMIT_LOCKOUT_WINDOW_S=900
RATELIMIT_REFRESH_MAX_ATTEMPTS=30
RATELIMIT_REFRESH_WINDOW_S=60
RATELIMIT_ADMS_DEVICE_MAX=600
RATELIMIT_ADMS_DEVICE_WINDOW_S=60
RATELIMIT_ADMS_IP_MAX=3000
RATELIMIT_ADMS_IP_WINDOW_S=60

# Command lifecycle
ZKTECO_COMMAND_TTL_S=86400
ZKTECO_COMMAND_MAX_ATTEMPTS=10

# HTTP surface (proxy owns TLS/HSTS/CSP; see docs/SECURITY.md)
# TRUSTED_PROXIES_RAW=10.0.0.0/8
# FRONTEND_ORIGINS_RAW=https://admin.example.com
# HSTS_ENABLED=true
# DOCS_ENABLED=false
